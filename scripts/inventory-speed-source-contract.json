        {
          "offset": 444,
          "before": "function restore(bytes,file,target){assert(Buffer.isBuffer(bytes),'IPQC assignment/speed proof requires raw Buffer');const c=Object.hasOwn(contract.files,file)?contract.files[file]:null,p=c&&c.parents[target];assert(p,'IPQC assignment/speed wrong path/target');let out=normalized(bytes);assert.equal(hash(out),c.afterHash,'IPQC assignment/speed unknown source');for(const r of [...p.rules].reverse()){const span=Buffer.from(r.after);assert(out.subarray(r.offset,r.offset+span.length).equals(span),'IPQC assignment/speed positioned span');out=Buffer.concat([out.subarray(0,r.offset),Buffer.from(r.before),out.subarray(r.offset+span.length)]);}assert.equal(hash(out),p.normalizedHash);const lines=out.toString().split('\\n');for(const i of p.crlf)lines[i]+='\\r';out=Buffer.from(lines.join('\\n'));assert.equal(hash(out),p.hash,'IPQC assignment/speed exact parent');return out;}\nfunction projectKnown(bytes,file,target){assert(Buffer.isBuffer(bytes),'IPQC assignment/speed proof requires raw Buffer');const c=Object.hasOwn(contract.files,file)?contract.files[file]:null;return c&&c.parents[target]&&hash(normalized(bytes))===c.afterHash?restore(bytes,file,target):bytes;}\n",
          "after": "function restore(bytes,file,target){assert(Buffer.isBuffer(bytes),'IPQC assignment/speed proof requires raw Buffer');bytes=require('./inventory-speed-source-contract.cjs').projectKnown(bytes,file);const c=Object.hasOwn(contract.files,file)?contract.files[file]:null,p=c&&c.parents[target];assert(p,'IPQC assignment/speed wrong path/target');let out=normalized(bytes);assert.equal(hash(out),c.afterHash,'IPQC assignment/speed unknown source');for(const r of [...p.rules].reverse()){const span=Buffer.from(r.after);assert(out.subarray(r.offset,r.offset+span.length).equals(span),'IPQC assignment/speed positioned span');out=Buffer.concat([out.subarray(0,r.offset),Buffer.from(r.before),out.subarray(r.offset+span.length)]);}assert.equal(hash(out),p.normalizedHash);const lines=out.toString().split('\\n');for(const i of p.crlf)lines[i]+='\\r';out=Buffer.from(lines.join('\\n'));assert.equal(hash(out),p.hash,'IPQC assignment/speed exact parent');return out;}\nfunction projectKnown(bytes,file,target){assert(Buffer.isBuffer(bytes),'IPQC assignment/speed proof requires raw Buffer');if(!Object.hasOwn(contract.parents,target))return bytes;bytes=require('./inventory-speed-source-contract.cjs').projectKnown(bytes,file);const c=Object.hasOwn(contract.files,file)?contract.files[file]:null;return c&&c.parents[target]&&hash(normalized(bytes))===c.afterHash?restore(bytes,file,target):bytes;}\n"
